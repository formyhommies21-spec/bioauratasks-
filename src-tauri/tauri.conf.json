{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BIOAURA Tasks",
  "mainBinaryName": "bioaura-tasks",
  "version": "0.1.0",
  "identifier": "io.resetaura.tasks-widget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "BIOAURA Задачи",
        "width": 340,
        "height": 520,
        "minWidth": 240,
        "minHeight": 180,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "skipTaskbar": true,
        "visible": false,
        "alwaysOnTop": false,
        "center": false,
        "x": 60,
        "y": 80
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "category": "Productivity",
    "shortDescription": "Виджет задач BIOAURA Organism",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}
